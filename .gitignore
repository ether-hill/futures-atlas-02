# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
# a second dev server's build dir (NEXT_DIST_DIR, see next.config.ts)
/.next-*/
/out/

# sub-app bundles — built from source on every deploy by scripts/build-subapps.sh
# (NOT committed, so two builders can never clobber each other's bundle). The
# remaining zone bundles under public/ (underground-intelligence,
# odds-of-surviving-ai) are NOT ignored — they are hand-authored with no build
# step, so they stay committed.
/public/generatives/
/public/literal-frequency/
/public/hyperscale/
/public/gigawatt/
/public/trajectories/
/public/mappings/
/public/quantum-sandbox/
/public/social-composer/
/public/village-oracle/
/public/swipe-the-future/
/swipe-the-future/.next/
/swipe-the-future/node_modules/
/swipe-the-future/out/
/public/swipe-v1/

# Counterfactual Index — built from source by scripts/build-subapps.sh, so the
# bundle is never committed (two people can't clobber each other's build).
/public/manipulate-the-data/
/manipulate-the-data/.next/
/manipulate-the-data/node_modules/
/manipulate-the-data/out/
/swipe-v1/.next/
/swipe-v1/node_modules/
/swipe-v1/out/
/public/woodchipper/
/woodchipper/.next/
/woodchipper/node_modules/
/woodchipper/out/
/public/quantum-dominance/
/quantum-dominance/.next/
/quantum-dominance/node_modules/
/quantum-dominance/out/
/public/signal-reactor/
/signal-reactor/.next/
/signal-reactor/node_modules/
/signal-reactor/out/
/public/quantum-spark/

# Magnifica — built from magnifica/ source on every deploy
/public/magnifica/
/magnifica/node_modules/
/quantum-spark/.next/
/quantum-spark/node_modules/
/quantum-spark/out/
/generatives/.next/
/literal-frequency/.next/
/quantum-sandbox/.next/
/generatives/node_modules/
/literal-frequency/node_modules/
/hyperscale/node_modules/
/gigawatt/node_modules/
/trajectories/node_modules/
/mappings/node_modules/
/quantum-sandbox/node_modules/
/social-composer/node_modules/
/social-composer/out/
/generatives/dist/
/literal-frequency/dist/
/quantum-sandbox/dist/
/hollow-villages/node_modules/
/hollow-villages/.next/
/hollow-villages/out/
/hollow-villages/vendor/futures-atlas-core/node_modules/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

# Magnifica — raw pre-compression clips (the encoded loops under
# magnifica/public/media/loops/ are what ship)
/magnifica/video/

# Quantum Lag — built from quantum-lag/ source on every deploy
/public/quantum-lag/
/quantum-lag/out/
/quantum-lag/.next/

# staged copies of assets/fonts (see scripts/build-subapps.sh); the source is committed
*/assets/fonts/

# THE footer, generated by scripts/gen-footer.mjs from projects.ts / posts.ts /
# glossary.ts. Two outputs, one string: the html is fetched by atlas-nav.js on
# the sub-apps, the module is imported by <Footer> on the host. Build artifacts,
# so not committed — regenerated by `npm run dev` (predev) and by the build.
/public/atlas-footer.html
/src/generated/

# Left over from the rename of The Counterfactual Index to manipulate-the-data.
# Nothing in the committed build references either path: build-subapps.sh builds
# manipulate-the-data/ and copies it to public/manipulate-the-data/. The source
# folder is ~493MB of stale .next output and neither has a single tracked file,
# so they are ignored rather than committed — and left on disk rather than
# deleted, because removing half a gigabyte of someone's files is their call.
/counterfactual/
/public/counterfactual/

# session scratch files — working notes/renders, never part of the site
/scratchpad/

# The design system, staged into each consumer by scripts/build-subapps.sh from
# the one canonical copy at packages/futures-atlas-core. These used to be
# hand-maintained and silently drifted apart; they are build output now, so they
# are not committed. Edit packages/, never a vendor/ tree.
/hollow-villages/vendor/futures-atlas-core/
/manipulate-the-data/vendor/futures-atlas-core/
/quantum-lag/vendor/futures-atlas-core/
